{
  "name": "tenant-mcp",
  "version": "0.1.0",
  "description": "Persönlicher Job-Match- und Bewerbungs-Zugang (Tenant) für Claude Desktop via MCPB.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=server/index.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "inspect": "node server/index.js",
    "validate": "mcpb validate manifest.json",
    "pack": "npm run build && mcpb pack . tenant-mcp.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^1.1.0",
    "@modelcontextprotocol/inspector": "^0.14.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
